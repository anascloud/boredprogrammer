@model Post

@{
    ViewData["Title"] = Model.Title;
}

<style>
    .contect-wrapper {
        padding: 20px;
        max-width:;
        1000px;
        margin: 0 auto;
        font-family: sans-serif;
    }
</style>

<div class="text-end">
    <a class="btn btn-secondary my-3">Edit Post</a>
    <a class="btn btn-secondary m-3">Delete Post</a>
</div>

<div class="contect-wrapper">
    <h1>@Model.Title</h1>
    <p>
        <span class="badge badge-primary">
            By:
        </span>
        @Model.Author |
        <span class="badge badge-primary">
            Published on 
        </span>
        @Model.PublishedDate.ToString("MMMM dd, yyyy")
    </p>
    <p><span class="basdge badge-secondary">Category</span>@Model.Category.Name</p>
    <img src="@Model.FeatureImagePath" alt="@Model.Title" class="feature-image" />
    <hr />

    @if (Model.Comments.Any())
    {
        <div>
            @foreach(var comment in Model.Comments)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <h4 class="card-title">@comment.UserName</h4>
                        <p class="card-text text-muted">@comment.Commentdate.ToString("MMMM dd,yyyy")</p>
                        <p class="card-text">@comment.Content</p>
                    </div>
                </div>
            }
        </div>
    }
    else{
        <p class="text-muted">No comments yet. Be the first one to comment.</p>
    }
    <h4>Add a Comment</h4>
    <form id="commentForm">
        <div class="form-group">
            <label for="Username">Name</label>
            <input for="Username" id="Username" name="Username" required class="form-control" />
        </div>
        <div class="form-group">
            <label for="Content">Content</label>
            <input for="Content" id="Content" name="Content" required class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary mt-2 p-2 rounded">Submit Comment</button>
    </form>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $("commentForm").on('submit', function (event) {
                event.preventDefault();
                var userName = $("#Username").val(); 
                var content = $("#Content").val();
                var postId = @Model.Id;
                console.log("userName", userName);
            });
        });
    </script>
}