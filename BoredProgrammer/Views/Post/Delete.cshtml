@model Post
@{
    ViewData["Title"] = "Delete Post";
}

<div class="auth-shell">
    <div class="panel reveal" style="max-width:560px;width:100%;">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="feature-icon" style="background:rgba(248,113,113,.12);border-color:rgba(248,113,113,.35);color:#fca5a5;"><i class="bi bi-trash"></i></span>
            <h1 style="font-size:1.3rem;" class="m-0">Delete this post?</h1>
        </div>
        <p class="text-soft">You're about to permanently delete <strong>@Model.Title</strong>. This action cannot be undone.</p>
        <form asp-controller="Post" asp-action="DeleteConfirm">
            <input asp-for="@Model.Id" hidden />
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete permanently</button>
                <a asp-action="Index" asp-controller="Post" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
