@model PostViewModel

@{
    ViewData["Title"] = "Create Post";
}

<style>
    .contect-wrapper {
        padding: 20px;
        max-width:;1000px;
        margin: 0 auto;
        font-family: sans-serif;
    }
</style>

<div class="contect-wrapper">
    <div class="row">
        <div class="col-6">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-primary">Back to List</a>
        </div>
    </div>

    <hr />

    <form asp-action="Create" asp-controller="Post" method="post" enctype="mmultipart/form-data">
        <div class="form-group">
            <label asp-for="Post.Title"></label>
            <input asp-for="Post.Title" class="form-control" />
        </div>
    </form>
</div>