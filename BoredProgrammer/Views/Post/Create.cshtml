@model PostViewModel
@{
    ViewData["Title"] = "Create Post";
}

<section class="page-head">
    <span class="eyebrow">Admin · content studio</span>
    <h1 class="mt-2">Create a <span class="text-gradient">new post</span></h1>
    <p class="mb-0">Write it yourself — or let the AI draft a structured starting point in seconds.</p>
</section>

<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="Create" asp-controller="Post" method="post" enctype="multipart/form-data" class="panel">
            <div class="form-head mb-3">
                <h2 style="font-size:1.15rem;" class="m-0"><i class="bi bi-pencil-square me-2"></i>Post details</h2>
                <a class="btn btn-sm btn-ghost" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back</a>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="Post.Title"></label>
                <input asp-for="Post.Title" class="form-control" placeholder="A clear, compelling title" />
                <span asp-validation-for="Post.Title" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="Post.CategoryId"></label>
                    <select asp-for="Post.CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">Select category</option>
                    </select>
                    <span asp-validation-for="Post.CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Post.Author"></label>
                    <input asp-for="Post.Author" class="form-control" placeholder="Author name" />
                    <span asp-validation-for="Post.Author" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Post.Content"></label>
                <textarea asp-for="Post.Content" class="form-control" rows="12" placeholder="Write your article…"></textarea>
                <span asp-validation-for="Post.Content" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="FeatureImage"></label>
                <input asp-for="FeatureImage" class="form-control" accept=".jpg,.jpeg,.png" />
                <div class="form-text">JPG or PNG only. Leave empty to use the branded placeholder.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gradient px-4"><i class="bi bi-check2 me-1"></i>Publish</button>
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="panel mb-3">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="feature-icon" style="width:36px;height:36px;font-size:.95rem;"><i class="bi bi-stars"></i></span>
                <h2 style="font-size:1.02rem;" class="m-0">AI content studio</h2>
            </div>
            <p class="text-soft small mb-3">Give the AI a topic. It returns a title, HTML body, excerpt and tags — then you refine.</p>

            <form id="aiStudioForm" data-endpoint="@Url.Action("GeneratePost", "Ai")">
                <label class="form-label" for="aiTopic">Topic</label>
                <input id="aiTopic" class="form-control mb-2" placeholder="e.g. Building RAG with .NET and Qdrant" required />
                <label class="form-label" for="aiTone">Tone</label>
                <select id="aiTone" class="form-select mb-3">
                    <option value="professional">Professional</option>
                    <option value="practical">Practical / how-to</option>
                    <option value="opinionated">Opinionated</option>
                    <option value="friendly">Friendly</option>
                </select>
                <button type="submit" class="btn btn-gradient w-100" id="aiGenerateBtn">
                    <i class="bi bi-magic me-1"></i>Generate draft
                </button>
            </form>

            <div id="aiStudioResult" class="mt-3 d-none">
                <div class="d-flex flex-wrap gap-1 mb-2" id="aiTags"></div>
                <div class="ai-summary">
                    <div class="ai-summary-head"><i class="bi bi-card-text"></i><strong>Suggested excerpt</strong></div>
                    <div class="summary-body" id="aiExcerpt"></div>
                </div>
                <div class="form-text">The title and body were filled in the form. Review before publishing.</div>
            </div>
        </div>

        <div class="panel">
            <h3 style="font-size:.95rem;" class="mb-2"><i class="bi bi-lightbulb me-2"></i>Publishing checklist</h3>
            <ul class="list-unstyled text-soft small mb-0">
                <li class="mb-2"><i class="bi bi-check2-circle me-2" style="color:#6ee7b7;"></i>Specific, useful title</li>
                <li class="mb-2"><i class="bi bi-check2-circle me-2" style="color:#6ee7b7;"></i>One clear takeaway per section</li>
                <li class="mb-2"><i class="bi bi-check2-circle me-2" style="color:#6ee7b7;"></i>Code samples where relevant</li>
                <li><i class="bi bi-check2-circle me-2" style="color:#6ee7b7;"></i>Feature image or placeholder</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/fkuhrxkmvroy0pim3ota55d5229ra3tdelnst9krrrt705do/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    <script>
        tinymce.init({ selector: 'textarea', height: 420, menubar: false, plugins: 'lists link code', toolbar: 'undo redo | bold italic | bullist numlist | link code' });

        (function () {
            const form = document.getElementById("aiStudioForm");
            if (!form) return;

            form.addEventListener("submit", async function (event) {
                event.preventDefault();
                const button = document.getElementById("aiGenerateBtn");
                const original = button.innerHTML;
                const topic = document.getElementById("aiTopic").value.trim();
                if (!topic) return;

                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generating…';

                try {
                    const response = await fetch(form.dataset.endpoint, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ topic: topic, tone: document.getElementById("aiTone").value })
                    });
                    const data = await response.json();

                    if (!data.ok) {
                        window.bpToast?.(data.message || "AI generation is unavailable.", "error");
                        return;
                    }

                    const titleInput = document.getElementById("Post_Title");
                    if (titleInput && data.title) titleInput.value = data.title;

                    const editor = window.tinymce && tinymce.get("Post_Content");
                    if (editor) editor.setContent(data.content || "");
                    else document.getElementById("Post_Content").value = data.content || "";

                    document.getElementById("aiExcerpt").textContent = data.excerpt || "";
                    const tags = document.getElementById("aiTags");
                    tags.innerHTML = "";
                    (data.tags || []).forEach(function (tag) {
                        const chip = document.createElement("span");
                        chip.className = "tag";
                        chip.textContent = "#" + tag;
                        tags.appendChild(chip);
                    });
                    document.getElementById("aiStudioResult").classList.remove("d-none");
                    window.bpToast?.("AI draft generated — review and publish");
                } catch (e) {
                    window.bpToast?.("Could not reach the AI service.", "error");
                } finally {
                    button.disabled = false;
                    button.innerHTML = original;
                }
            });
        })();
    </script>
}
