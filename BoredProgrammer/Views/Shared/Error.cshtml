@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="auth-shell">
    <div class="panel text-center reveal" style="max-width:560px;width:100%;">
        <span class="feature-icon mx-auto" style="width:56px;height:56px;font-size:1.5rem;background:rgba(248,113,113,.12);border-color:rgba(248,113,113,.35);color:#fca5a5;"><i class="bi bi-exclamation-triangle"></i></span>
        <h1 class="mt-3" style="font-size:1.5rem;">Something went wrong</h1>
        <p class="text-soft">An unexpected error occurred while processing your request. Please try again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-soft">Request ID: <code>@Model.RequestId</code></p>
        }
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-gradient" asp-controller="Post" asp-action="Index">Back to blog</a>
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">Home</a>
        </div>
    </div>
</div>
