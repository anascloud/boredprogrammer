<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Anascloud</title>
    <meta name="description" content="@PortfolioProfile.Summary" />
    <meta name="theme-color" content="#04060b" />
    <meta property="og:title" content="@ViewData["Title"] · anascloud" />
    <meta property="og:description" content="@PortfolioProfile.Tagline" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootwatch/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var theme = localStorage.getItem("bp-theme");
                if (theme === "light") document.documentElement.setAttribute("data-bs-theme", "light");
            } catch (e) { }
        })();
    </script>
</head>
<body>
    <header>
        <partial name="_Navbar" />
    </header>

    <main role="main" class="site-main">
        <div class="container-xxl px-3 px-lg-4">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container-xxl px-3 px-lg-4">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a class="brand" asp-controller="Post" asp-action="Index">
                        <span class="brand-mark"><i class="bi bi-stars"></i></span>
                        <span>Anascloud</span>
                    </a>
                    <p class="text-soft mt-2 mb-0">@PortfolioProfile.Tagline</p>
                    <div class="d-flex gap-2 mt-3">
                        <a class="icon-btn" href="@PortfolioProfile.GitHub" target="_blank" rel="noopener" aria-label="GitHub"><i class="bi bi-github"></i></a>
                        <a class="icon-btn" href="@PortfolioProfile.LinkedIn" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a class="icon-btn" href="mailto:@PortfolioProfile.Email" aria-label="Email"><i class="bi bi-envelope"></i></a>
                    </div>
                </div>
                <div>
                    <h6 class="footer-title">Explore</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Post" asp-action="Index">Blog</a></li>
                        <li><a asp-controller="Home" asp-action="Features">Features</a></li>
                        <li><a asp-controller="Ai" asp-action="Assistant">AI Assistant</a></li>
                        <li><a asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                    </ul>
                </div>
                <div>
                    <h6 class="footer-title">About</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Resume">Resume / CV</a></li>
                        <li><a href="mailto:@PortfolioProfile.Email">Hire me</a></li>
                        <li><a href="/health" target="_blank" rel="noopener">System health</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                </div>
                <div>
                    <h6 class="footer-title">Built with</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="chip">.NET 10</span>
                        <span class="chip">ASP.NET Core</span>
                        <span class="chip">EF Core</span>
                        <span class="chip">Groq</span>
                        <span class="chip">SQL Server</span>
                        <span class="chip">Azure</span>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.UtcNow.Year anascloud · @PortfolioProfile.Name</span>
                <span class="tag-live"><i class="bi bi-circle-fill"></i> Live demo · anascloud.runasp.net</span>
            </div>
        </div>
    </footer>

    <partial name="_AiWidget" />
    <div id="toastHost" class="toast-host" aria-live="polite"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
