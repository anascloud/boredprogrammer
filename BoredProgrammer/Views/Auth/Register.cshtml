@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-shell">
    <div class="auth-card">
        <aside class="auth-side d-none d-md-flex flex-column justify-content-between">
            <div>
                <a class="brand mb-4 d-inline-flex" asp-controller="Post" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-stars"></i></span>
                    <span>anascloud</span>
                </a>
                <h2>Join the <span class="text-gradient">conversation</span>.</h2>
                <p class="text-soft mt-2">Create a free reader account to comment on posts and follow the build notes.</p>
                <ul>
                    <li><i class="bi bi-check-circle"></i> Comment on any article</li>
                    <li><i class="bi bi-check-circle"></i> Ask the AI assistant anything</li>
                    <li><i class="bi bi-check-circle"></i> No credit card, no spam</li>
                </ul>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <span class="chip">Free account</span>
                <span class="chip">Secure Identity</span>
            </div>
        </aside>

        <div class="auth-form">
            <span class="eyebrow">Get started</span>
            <h1 class="mt-2 mb-1" style="font-size:1.5rem;">Create account</h1>
            <p class="text-soft small mb-3">It takes less than a minute.</p>

            <form asp-action="Register" asp-controller="Auth" method="post">
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="At least 6 characters" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repeat password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-gradient w-100"><i class="bi bi-person-plus me-1"></i>Create account</button>
            </form>

            <p class="text-soft small mt-3 mb-0">
                Already have an account? <a asp-action="Login" asp-controller="Auth">Sign in</a>
            </p>
        </div>
    </div>
</div>
