@{
    ViewData["Title"] = "Access Denied";
}
<div class="auth-shell">
    <div class="panel text-center reveal" style="max-width:520px;width:100%;">
        <span class="feature-icon mx-auto" style="width:56px;height:56px;font-size:1.5rem;background:rgba(248,113,113,.12);border-color:rgba(248,113,113,.35);color:#fca5a5;"><i class="bi bi-shield-lock"></i></span>
        <h1 class="mt-3" style="font-size:1.5rem;">Access denied</h1>
        <p class="text-soft">You don't have permission to view this page. Admin access is required for authoring features.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-gradient" asp-controller="Post" asp-action="Index">Back to blog</a>
            <a class="btn btn-ghost" asp-controller="Auth" asp-action="Login">Sign in</a>
        </div>
    </div>
</div>
