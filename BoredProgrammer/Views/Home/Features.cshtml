<section class="page-head">
    <div class="row align-items-end g-3">
        <div class="col-lg-8">
            <span class="eyebrow">Feature tour</span>
            <h1 class="mt-2">Impressive features, <span class="text-gradient">built to be inspected</span>.</h1>
            <p class="mb-0">
                This is the focus list — every card below maps to something you can click, test and review live.
                AI, product craft, engineering and security in one demo.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a class="btn btn-gradient px-3" asp-controller="Ai" asp-action="Assistant"><i class="bi bi-stars me-2"></i>Start with AI</a>
            <a class="btn btn-ghost px-3" asp-controller="Home" asp-action="Dashboard"><i class="bi bi-graph-up me-2"></i>Dashboard</a>
        </div>
    </div>
</section>

<hr class="hairline" />

@foreach (var group in groups)
{
    <section class="section feature-group" id="@group.Id">
        <div class="feature-group-head reveal">
            <div>
                <span class="eyebrow">@group.Title</span>
                <h2 class="mt-1">@group.Subtitle</h2>
            </div>
            <span class="chip">@group.Items.Length features</span>
        </div>
        <div class="row g-3">
            @foreach (var item in group.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card reveal h-100 d-flex flex-column">
                        <span class="feature-icon"><i class="bi @item.Icon"></i></span>
                        <h3>@item.Title</h3>
                        <p>@item.Text</p>
                        <div class="feature-tags">
                            @foreach (var tag in item.Tags)
                            {
                                <span class="tag">@tag</span>
                            }
                        </div>
                        <a class="try-link mt-auto" href="@item.Link" target="@(item.Link?.StartsWith("http") == true ? "_blank" : null)" rel="@(item.Link?.StartsWith("http") == true ? "noopener" : null)">
                            @item.Cta <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="section">
    <div class="panel reveal">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <span class="eyebrow">Under the hood</span>
                <h2 class="mt-2">A stack chosen for <span class="text-gradient">longevity</span>.</h2>
                <p class="text-soft mb-3">
                    ASP.NET Core MVC on .NET 10, EF Core with SQL Server, Identity, a typed Groq client,
                    Bootstrap 5 and a custom token-based design system. No UI framework bloat.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var skill in PortfolioProfile.Skills)
                    {
                        <span class="chip"><i class="bi @skill.Icon"></i>@skill.Name</span>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="row g-2">
                    @foreach (var project in PortfolioProfile.Projects)
                    {
                        <div class="col-12">
                            <a class="list-row" href="@Url.Action("Resume", "Home")">
                                <span class="feature-icon" style="width:38px;height:38px;font-size:1rem;"><i class="bi @project.Icon"></i></span>
                                <span>
                                    <span class="row-title d-block">@project.Name</span>
                                    <span class="row-sub">@project.Tagline</span>
                                </span>
                                <span class="row-badge chip">@project.Impact</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
